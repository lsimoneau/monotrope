services:
  web:
    image: {{ karakeep_image }}
    restart: unless-stopped
    volumes:
      - karakeep_data:/data
    ports:
      - "{{ karakeep_port }}:3000"
    env_file:
      - .env
    environment:
      MEILI_ADDR: http://meilisearch:7700
      BROWSER_WEB_URL: http://chrome:9222
      DATA_DIR: /data

  chrome:
    image: {{ karakeep_chrome_image }}
    restart: unless-stopped
    command:
      - --no-sandbox
      - --disable-gpu
      - --disable-dev-shm-usage
      - --remote-debugging-address=0.0.0.0
      - --remote-debugging-port=9222
      - --hide-scrollbars

  meilisearch:
    image: {{ karakeep_meili_image }}
    restart: unless-stopped
    env_file:
      - .env
    environment:
      MEILI_NO_ANALYTICS: "true"
    volumes:
      - karakeep_meilisearch:/meili_data

volumes:
  karakeep_data:
  karakeep_meilisearch:
