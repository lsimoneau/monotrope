model:
  provider: openrouter
  default: minimax/minimax-m2.7
memory:
  memory_enabled: true
  user_profile_enabled: true
agent:
  max_turns: 70
TELEGRAM_HOME_CHANNEL: '8455090116'
EMAIL_HOME_CHANNEL: louis@monotrope.au

# Capability brokers (infra/broker_core + roles/ops_broker). Each is a narrow,
# allowlisted MCP server running on a managed host; Hermes is a pure client and
# can only invoke the tools listed under include. Tools surface to the model as
# mcp_apps_ops_<tool>.
mcp_servers:
  apps_ops:
    url: "http://{{ hostvars['apps'].ansible_host }}:9988/mcp"
    headers:
      Authorization: "Bearer {{ ops_broker_token }}"
    tools:
      include: [list_services, service_status, get_logs, restart_service]
      prompts: false
      resources: false
