[Unit]
Description=Hermes Agent gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HERMES_HOME={{ hermes_home }}
EnvironmentFile=/etc/default/hermes-gateway
ExecStart=/usr/local/bin/hermes gateway run
WorkingDirectory={{ hermes_home }}
Restart=on-failure
RestartSec=5
# Don't kill the process group on stop — let hermes shut its gateways down
# gracefully so in-flight Telegram/email replies aren't truncated.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
