#!/opt/libro-venv/bin/python
"""Libro.fm→Audiobookshelf ingestion sweep.

Lists the Libro.fm library via librofm, matches against per-book folders
in /audiobooks, and downloads anything missing. State is keyed by ISBN
so the loop is idempotent across runs.

Layout: /audiobooks/<Author>/<Title>/<files> — librofm writes per-part
MP3s or a single M4B into the folder; it does not auto-organise, so
the script creates the dir.

Runs inside the libro-ingest container; a host-side systemd timer fires
`docker exec` daily.
"""
import json
import logging
import os
import random
import re
import shutil
import sys
import time
import unicodedata
from pathlib import Path

import requests
from librofm import client as _librofm_client
from librofm.client import LibroFMClient

LIBRARY = Path("/audiobooks")
STATE_DIR = Path("/var/lib/libro-ingest")
STATE = STATE_DIR / "state.json"
ENV_FILE = STATE_DIR / ".env"

TERMINAL = {"imported", "pinned"}
ILLEGAL_FS = re.compile(r'[<>:"/\\|?*\x00-\x1f]')
AUDIO_EXT = (".mp3", ".m4b")

# Default to WARNING so a failed Libro.fm login (non-JSON 401/403/429, or an
# empty body) ends up in `journalctl -u libro-ingest` as a real diagnostic
# line — status code + first 500 chars of the body — instead of a useless
# "Expecting value: line 1 column 1 (char 0)" from json.loads. Set LOG_LEVEL
# in the systemd unit to override (e.g. LOG_LEVEL=INFO for full request logs).
LOG_LEVEL = os.environ.get("LOG_LEVEL", "WARNING").upper()
logging.basicConfig(
    level=LOG_LEVEL,
    format="%(asctime)s %(levelname)s libro-ingest: %(message)s",
    stream=sys.stderr,
)
log = logging.getLogger("libro-ingest")

SLEEP_MIN = int(os.environ.get("SLEEP_MIN", "30"))
SLEEP_MAX = int(os.environ.get("SLEEP_MAX", "90"))
MAX_PER_RUN = int(os.environ["MAX_PER_RUN"]) if os.environ.get("MAX_PER_RUN") else None


def _do_post_logged(self, endpoint, data):
    """Drop-in replacement for LibroFMClient._do_post that logs the raw
    response before parsing. Vendored librofm raises a bare
    `requests.exceptions.JSONDecodeError` on a non-JSON body, which strips
    away the only useful diagnostic (status code + body). We log it at
    WARNING so the failure mode is visible in `journalctl -u libro-ingest`,
    then call `raise_for_status()` so 4xx responses (the likely cause —
    bad credentials, rate limit, captcha wall) surface as a real
    `HTTPError` rather than a misleading `JSONDecodeError`. Two small
    behaviour changes vs. vendored:

      * Non-2xx responses raise `HTTPError` instead of `JSONDecodeError`.
      * The exact response body is logged at WARNING.

    Installed via monkey-patch in `main()` so a future `pip install
    --upgrade librofm` can't silently undo this fix.
    """
    resp = requests.post(
        f"{_librofm_client.BASE_URL}{endpoint}",
        headers=self.headers,
        json=data,
    )
    body_preview = (resp.text or "")[:500]
    log.warning(
        "librofm %s -> %s (body[:500]=%r)",
        endpoint, resp.status_code, body_preview,
    )
    resp.raise_for_status()
    return resp.json()


def safe_name(s: str) -> str:
    s = unicodedata.normalize("NFKC", s)
    s = ILLEGAL_FS.sub("", s).strip().rstrip(".")
    return re.sub(r"\s+", " ", s)


def load_env_file(path: Path) -> None:
    if not path.exists():
        raise RuntimeError(f"missing env file: {path}")
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k, v = k.strip(), v.strip()
        if v and v[0] == v[-1] and v[0] in ("'", '"'):
            v = v[1:-1]
        os.environ.setdefault(k, v)


def first_author(authors: list[str]) -> str:
    if not authors:
        return "Unknown Author"
    a = (authors[0] or "").strip()
    return a or "Unknown Author"


def book_folder(author: str, title: str) -> Path:
    return LIBRARY / safe_name(author) / safe_name(title)


def looks_complete(folder: Path) -> bool:
    return folder.is_dir() and any(
        p.is_file() and p.suffix.lower() in AUDIO_EXT for p in folder.iterdir()
    )


def has_files(folder: Path) -> bool:
    return folder.is_dir() and any(folder.iterdir())


def persist_state(state: dict) -> None:
    """Atomically replace STATE with a JSON dump of `state`.

    Defensive on write failure: if the state dir is unwritable (e.g. a
    fresh volume with ownership from a different uid, or a host-side
    bind-mount with restrictive perms), log a warning and return. A
    stale-but-readable state.json is strictly better than crashing the
    sweep's failure path with a PermissionError — the failure path is
    exactly where we most need the real-cause diagnostic to surface.
    """
    try:
        tmp = STATE.with_suffix(".tmp")
        tmp.write_text(json.dumps(state, indent=2, sort_keys=True))
        tmp.replace(STATE)
    except OSError as e:
        log.warning("could not persist state to %s: %s", STATE, e)


def main() -> int:
    load_env_file(ENV_FILE)
    username = os.environ["LIBROFM_USERNAME"]
    password = os.environ["LIBROFM_PASSWORD"]
    # Patch vendored librofm before any call so its `_do_post` logs the raw
    # response. Survives `pip install --upgrade librofm` because the override
    # lives in our wrapper, not in site-packages.
    _librofm_client.LibroFMClient._do_post = _do_post_logged
    client = LibroFMClient(username, password)

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    state = json.loads(STATE.read_text()) if STATE.exists() else {}

    counts = dict(downloaded=0, already=0, errors=0)

    page_num = 1
    total_pages = None
    while total_pages is None or page_num <= total_pages:
        try:
            page = client.get_library(page=page_num)
        except Exception as e:
            # librofm's authenticate() retry already logs at WARNING via the
            # _do_post patch; this catch is the last-chance handler so the
            # sweep exits cleanly with a counted error instead of an
            # uncaught traceback on a half-paginated library.
            log.error("get_library(page=%d) failed: %s", page_num, e)
            counts["errors"] += 1
            persist_state(state)
            print(" ".join(f"{k}={v}" for k, v in counts.items()))
            return 1
        if total_pages is None:
            total_pages = page.total_pages

        for book in page.audiobooks:
            isbn = str(book.isbn)
            title = (book.title or "").strip()
            if not title:
                continue
            author = first_author(book.authors or [])
            folder = book_folder(author, title)

            status = state.get(isbn, {}).get("status")
            if status in TERMINAL and looks_complete(folder):
                continue

            if MAX_PER_RUN is not None and counts["downloaded"] >= MAX_PER_RUN:
                print(f"hit MAX_PER_RUN={MAX_PER_RUN}, stopping sweep early",
                      file=sys.stderr)
                persist_state(state)
                print(" ".join(f"{k}={v}" for k, v in counts.items()))
                return 0

            if has_files(folder):
                shutil.rmtree(folder)
            folder.mkdir(parents=True, exist_ok=True)

            try:
                client.download(book, str(folder))
                if not looks_complete(folder):
                    raise RuntimeError("download returned but no audio files in folder")
                state[isbn] = {
                    "status": "imported", "title": title, "author": author,
                    "downloaded_at": int(time.time()),
                }
                counts["downloaded"] += 1
                time.sleep(random.uniform(SLEEP_MIN, SLEEP_MAX))
            except Exception as e:
                counts["errors"] += 1
                print(f"ERROR: {isbn} {title!r}: {e}", file=sys.stderr)
                if folder.is_dir() and not any(folder.iterdir()):
                    folder.rmdir()

        page_num += 1

    persist_state(state)
    print(" ".join(f"{k}={v}" for k, v in counts.items()))
    return 1 if counts["errors"] else 0


if __name__ == "__main__":
    sys.exit(main())
